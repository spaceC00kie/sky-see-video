    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json,md}\" \"*.{ts,tsx,js,jsx,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,scss,json,md}\" \"*.{ts,tsx,js,jsx,css,scss,json,md}\"",
    "quality:check": "yarn type-check && yarn lint && yarn format:check",
    "quality:fix": "yarn type-check && yarn lint:fix && yarn format"
  },
